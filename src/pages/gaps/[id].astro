---
import Base from '../../layouts/Base.astro'; import { gaps,resources } from '../../lib/data'; import { withBase } from '../../lib/paths';
export function getStaticPaths(){return gaps.map((gap:any)=>({params:{id:gap.id},props:{gap}}));} const {gap}=Astro.props; const related=(gap.related_resources||gap.existing_solutions||[]).map((id:string)=>resources.find((r:any)=>r.id===id)).filter(Boolean);
---
<Base title={`${gap.title} — Gap — Islamic Tech Guide`}><div class="breadcrumb"><a href={withBase('/gaps/')}>Gaps</a><span>/</span><span>{gap.title}</span></div><div class="detail"><article class="detail-main panel"><div class="meta"><span class="tag accent">{gap.status}</span><span class="tag">{gap.determination}</span><span class="tag">confidence: {gap.confidence}</span>{gap.demo&&<span class="tag demo">SYNTHETIC DEMO DATA</span>}</div><h1>{gap.title}</h1><p class="lead">{gap.summary}</p>{gap.demo&&<div class="notice">This gap is synthetic and exists to test the complete editorial/UX model.</div>}<section class="content-section"><h2>Problem</h2><p>{gap.problem||gap.summary}</p></section>{related.length>0&&<section class="content-section"><h2>Existing solutions</h2><div class="related-list">{related.map((r:any)=><a class="related-item" href={withBase(`/resources/${r.id}/`)}><div><strong>{r.name}</strong><small>{r.resource_type} · {r.review_level}</small></div><span>→</span></a>)}</div></section>}{gap.what_is_missing?.length>0&&<section class="content-section"><h2>What is missing</h2><ul>{gap.what_is_missing.map((x:string)=><li>{x}</li>)}</ul></section>}{gap.reasoning?.length>0&&<section class="content-section"><h2>Editorial reasoning</h2><ul>{gap.reasoning.map((x:string)=><li>{x}</li>)}</ul></section>}{gap.evidence?.length>0&&<section class="content-section"><h2>Evidence</h2>{gap.evidence.map((e:any)=><div class="evidence"><strong>{e.type}</strong><br/><a href={e.url}>{e.url}</a>{e.note&&<p>{e.note}</p>}</div>)}</section>}</article><aside class="detail-side"><div class="panel sticky-panel"><h2 class="side-title">Gap metadata</h2><div class="facts"><div class="fact"><small>Domains</small>{(gap.domains||[]).join(' · ')||'—'}</div><div class="fact"><small>Audience</small>{(gap.audience||[]).join(' · ')||'—'}</div><div class="fact"><small>Affected platforms</small>{(gap.affected_platforms||[]).join(' · ')||'—'}</div><div class="fact"><small>Impact</small>{gap.impact||'—'}</div><div class="fact"><small>Difficulty</small>{gap.difficulty||'—'}</div><div class="fact"><small>Volunteer fit</small>{gap.volunteer_fit||'—'}</div><div class="fact"><small>Added</small>{gap.added_at||'—'}</div><div class="fact"><small>Last reviewed</small>{gap.last_reviewed_at||'—'}</div></div></div></aside></div></Base>
