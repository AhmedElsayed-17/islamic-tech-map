---
import Base from '../../layouts/Base.astro'; import { gaps } from '../../lib/data'; import { withBase } from '../../lib/paths';
const statuses=[...new Set(gaps.map((g:any)=>g.status).filter(Boolean))].sort(); const confidence=[...new Set(gaps.map((g:any)=>g.confidence).filter(Boolean))].sort(); const domains=[...new Set(gaps.flatMap((g:any)=>g.domains||[]))].sort();
---
<Base title="Gaps — Islamic Tech Guide"><div class="section-head"><div><div class="eyebrow">Editorial analysis</div><h1 class="page-title">Gaps</h1><p>Missing coverage, weak quality, maintenance, platform imbalance, integrations or standards. v0.1 uses editorial judgment rather than mandatory scoring.</p></div><div class="view-toggle"><button class="view-button active" data-gap-view="cards">Cards</button><button class="view-button" data-gap-view="table">Table</button></div></div>
<div class="filter-panel panel"><div class="filter-grid"><label class="field span-2"><span>Search</span><input id="gq" class="input" placeholder="Problem, missing capability, domain…"/></label><label class="field"><span>Domain</span><select id="gdomain" class="select"><option value="">All domains</option>{domains.map((x)=><option value={x}>{x}</option>)}</select></label><label class="field"><span>Status</span><select id="gstatus" class="select"><option value="">All statuses</option>{statuses.map((x)=><option value={x}>{x}</option>)}</select></label><label class="field"><span>Confidence</span><select id="gconfidence" class="select"><option value="">All confidence</option>{confidence.map((x)=><option value={x}>{x}</option>)}</select></label><label class="check-field"><input id="gdemo" type="checkbox"/> <span>Demo records only</span></label></div><div class="filter-footer"><span id="gapCount">{gaps.length} gaps</span><button id="greset" class="link-button">Reset filters</button></div></div>
<div id="gapCards" class="grid">{gaps.map((g:any)=><a class="card-link gap-item" href={withBase(`/gaps/${g.id}/`)} data-search={`${g.title} ${g.summary||''} ${g.problem||''} ${(g.what_is_missing||[]).join(' ')} ${(g.domains||[]).join(' ')}`.toLowerCase()} data-domains={(g.domains||[]).join(' ')} data-status={g.status||''} data-confidence={g.confidence||''} data-demo={g.demo?'true':'false'}><article class="card"><div class="meta"><span class="tag accent">{g.status}</span><span class="tag">confidence: {g.confidence}</span>{g.demo&&<span class="tag demo">DEMO</span>}</div><h3>{g.title}</h3><p>{g.summary}</p><div class="gap-metrics"><span>Impact <strong>{g.impact||'—'}</strong></span><span>Difficulty <strong>{g.difficulty||'—'}</strong></span><span>Volunteer fit <strong>{g.volunteer_fit||'—'}</strong></span></div></article></a>)}</div>
<div id="gapTable" class="table-wrap panel" hidden><table class="directory-table"><thead><tr><th>Gap</th><th>Domains</th><th>Status</th><th>Confidence</th><th>Impact</th><th>Difficulty</th><th>Volunteer fit</th><th></th></tr></thead><tbody>{gaps.map((g:any)=><tr class="gap-item" data-search={`${g.title} ${g.summary||''} ${g.problem||''} ${(g.what_is_missing||[]).join(' ')} ${(g.domains||[]).join(' ')}`.toLowerCase()} data-domains={(g.domains||[]).join(' ')} data-status={g.status||''} data-confidence={g.confidence||''} data-demo={g.demo?'true':'false'}><td><a class="table-name" href={withBase(`/gaps/${g.id}/`)}>{g.title}</a>{g.demo&&<span class="tag demo compact">DEMO</span>}<small>{g.summary}</small></td><td>{(g.domains||[]).join(', ')}</td><td>{g.status}</td><td>{g.confidence}</td><td>{g.impact||'—'}</td><td>{g.difficulty||'—'}</td><td>{g.volunteer_fit||'—'}</td><td><a href={withBase(`/gaps/${g.id}/`)}>Open →</a></td></tr>)}</tbody></table></div><div id="gempty" class="empty panel" hidden>No gaps match these filters.</div>
<script is:inline>const q=document.getElementById('gq'),d=document.getElementById('gdomain'),s=document.getElementById('gstatus'),c=document.getElementById('gconfidence'),demo=document.getElementById('gdemo'),cards=document.getElementById('gapCards'),table=document.getElementById('gapTable'),buttons=[...document.querySelectorAll('[data-gap-view]')];function root(){return table.hidden?cards:table}function match(el){const qs=q.value.trim().toLowerCase();return(!qs||el.dataset.search.includes(qs))&&(!d.value||el.dataset.domains.split(' ').includes(d.value))&&(!s.value||el.dataset.status===s.value)&&(!c.value||el.dataset.confidence===c.value)&&(!demo.checked||el.dataset.demo==='true')}function apply(){document.querySelectorAll('.gap-item').forEach(el=>el.hidden=!match(el));const n=[...root().querySelectorAll('.gap-item')].filter(el=>!el.hidden).length;gapCount.textContent=`${n} gap${n===1?'':'s'}`;gempty.hidden=n!==0}[q,d,s,c].forEach(x=>x.addEventListener('input',apply));demo.addEventListener('change',apply);greset.onclick=()=>{q.value='';d.value='';s.value='';c.value='';demo.checked=false;apply()};function setView(v){cards.hidden=v!=='cards';table.hidden=v!=='table';buttons.forEach(b=>b.classList.toggle('active',b.dataset.gapView===v));localStorage.setItem('gapView',v);apply()}buttons.forEach(b=>b.onclick=()=>setView(b.dataset.gapView));setView(localStorage.getItem('gapView')||'cards');</script></Base>
