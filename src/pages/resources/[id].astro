---
import Base from '../../layouts/Base.astro'; import { resources,gaps,text } from '../../lib/data'; import { withBase } from '../../lib/paths';
export function getStaticPaths(){return resources.map((resource:any)=>({params:{id:resource.id},props:{resource}}));} const {resource:r}=Astro.props; const related=(r.related_gaps||[]).map((rel:any)=>({rel,gap:gaps.find((g:any)=>g.id===rel.id)})).filter((x:any)=>x.gap); const en=text(r.summary,'en'), ar=text(r.summary,'ar');
---
<Base title={`${r.name} — Islamic Tech Guide`}><div class="breadcrumb"><a href={withBase('/resources/')}>Resources</a><span>/</span><span>{r.name}</span></div><div class="detail"><article class="detail-main panel"><div class="meta"><span class="tag accent">{r.resource_type}</span><span class="tag">{r.review_level}</span>{r.status?.value&&<span class="tag">{r.status.value}</span>}{r.demo&&<span class="tag demo">SYNTHETIC DEMO DATA</span>}</div><h1>{r.name}</h1><p class="lead">{en}</p>{ar&&ar!==en&&<p class="arabic-copy" dir="rtl">{ar}</p>}{r.demo&&<div class="notice">This record goes through the same schema and pages as real data. Its URLs and evaluation are synthetic.</div>}<div class="resource-actions"><a class="button" href={r.url} target="_blank">Official source ↗</a>{r.repository&&r.repository!==r.url&&<a class="button secondary" href={r.repository} target="_blank">Repository ↗</a>}</div>
{r.assessment&&<section class="content-section"><h2>Editorial assessment</h2><div class="assessment-grid">{r.assessment.strengths?.length>0&&<div class="assessment-box"><h3>Strengths</h3><ul>{r.assessment.strengths.map((x:string)=><li>{x}</li>)}</ul></div>}{r.assessment.weaknesses?.length>0&&<div class="assessment-box"><h3>Weaknesses</h3><ul>{r.assessment.weaknesses.map((x:string)=><li>{x}</li>)}</ul></div>}{r.assessment.best_for?.length>0&&<div class="assessment-box"><h3>Best for</h3><ul>{r.assessment.best_for.map((x:string)=><li>{x}</li>)}</ul></div>}{r.assessment.limitations?.length>0&&<div class="assessment-box"><h3>Limitations</h3><ul>{r.assessment.limitations.map((x:string)=><li>{x}</li>)}</ul></div>}</div></section>}
{r.recommendation&&<section class="content-section"><h2>Recommendation</h2><div class="recommendation"><div class="meta"><span class="tag accent">{r.recommendation.status}</span><span class="tag">confidence: {r.recommendation.confidence}</span></div><p>{r.recommendation.note}</p></div></section>}
{(r.capabilities||[]).length>0&&<section class="content-section"><h2>Capabilities</h2><div class="meta">{r.capabilities.map((x:string)=><span class="tag">{x}</span>)}</div></section>}
{related.length>0&&<section class="content-section"><h2>Related gaps</h2><div class="related-list">{related.map((x:any)=><a class="related-item" href={withBase(`/gaps/${x.gap.id}/`)}><div><strong>{x.gap.title}</strong><small>{x.rel.relation}</small></div><span>→</span></a>)}</div></section>}
{r.evidence?.length>0&&<section class="content-section"><h2>Evidence & sources</h2>{r.evidence.map((e:any)=><div class="evidence"><strong>{e.type}</strong>{e.supports&&<span> · {e.supports.join(' · ')}</span>}<br/><a href={e.url} target="_blank">{e.url}</a>{e.note&&<p>{e.note}</p>}</div>)}</section>}</article>
<aside class="detail-side"><div class="panel sticky-panel"><h2 class="side-title">Resource metadata</h2><div class="facts"><div class="fact"><small>Audience</small>{(r.audience||[]).join(' · ')||'—'}</div><div class="fact"><small>Roles</small>{(r.roles||[]).join(' · ')||'—'}</div><div class="fact"><small>Domains</small>{(r.domains||[]).join(' · ')||'—'}</div><div class="fact"><small>Platforms</small>{(r.platforms||[]).join(' · ')||'—'}</div><div class="fact"><small>Technologies</small>{(r.technologies||[]).join(' · ')||'—'}</div><div class="fact"><small>Languages</small>{(r.languages||[]).join(' · ')||'—'}</div><div class="fact"><small>Pricing</small>{r.pricing?.model||(r.access_model||[]).join(' · ')||'—'}</div><div class="fact"><small>Openness</small>{(r.openness||[]).join(' · ')||(r.open_source===true?'open_source':r.open_source===false?'closed_source':'—')}</div><div class="fact"><small>License</small>{r.license||'—'}</div><div class="fact"><small>Added</small>{r.added_at}</div><div class="fact"><small>Last reviewed</small>{r.last_reviewed_at}</div>{r.discovered_via&&<div class="fact"><small>Discovered via</small>{r.discovered_via.join(' · ')}</div>}</div></div></aside></div></Base>
