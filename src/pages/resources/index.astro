---
import Base from '../../layouts/Base.astro'; import { resources,text } from '../../lib/data'; import { withBase } from '../../lib/paths';
const types=[...new Set(resources.map((r:any)=>r.resource_type).filter(Boolean))].sort(); const domains=[...new Set(resources.flatMap((r:any)=>r.domains||[]))].sort(); const platforms=[...new Set(resources.flatMap((r:any)=>r.platforms||[]))].sort(); const statuses=[...new Set(resources.map((r:any)=>r.status?.value).filter(Boolean))].sort(); const levels=[...new Set(resources.map((r:any)=>r.review_level).filter(Boolean))].sort();
---
<Base title="Resources — Islamic Tech Guide"><div class="section-head"><div><div class="eyebrow">Browse</div><h1 class="page-title">Resources</h1><p>One dataset, multiple views. Cards and Table read the same Resource records.</p></div><div class="view-toggle"><button class="view-button active" data-view="cards">Cards</button><button class="view-button" data-view="table">Table</button></div></div>
<div class="filter-panel panel"><div class="filter-grid"><label class="field span-2"><span>Search</span><input id="q" class="input" placeholder="Name, summary, domain, technology…"/></label><label class="field"><span>Type</span><select id="type" class="select"><option value="">All types</option>{types.map((x)=><option value={x}>{x}</option>)}</select></label><label class="field"><span>Domain</span><select id="domain" class="select"><option value="">All domains</option>{domains.map((x)=><option value={x}>{x}</option>)}</select></label><label class="field"><span>Platform</span><select id="platform" class="select"><option value="">All platforms</option>{platforms.map((x)=><option value={x}>{x}</option>)}</select></label><label class="field"><span>Status</span><select id="status" class="select"><option value="">All statuses</option>{statuses.map((x)=><option value={x}>{x}</option>)}</select></label><label class="field"><span>Review</span><select id="review" class="select"><option value="">All review levels</option>{levels.map((x)=><option value={x}>{x}</option>)}</select></label><label class="check-field"><input id="demoOnly" type="checkbox"/> <span>Demo records only</span></label></div><div class="filter-footer"><span id="resultCount">{resources.length} resources</span><button id="reset" class="link-button">Reset filters</button></div></div>
<div id="cardView" class="grid">{resources.map((r:any)=><a class="card-link resource-item" href={withBase(`/resources/${r.id}/`)} data-search={`${r.name} ${text(r.summary)} ${(r.domains||[]).join(' ')} ${(r.technologies||[]).join(' ')}`.toLowerCase()} data-type={r.resource_type||''} data-domains={(r.domains||[]).join(' ')} data-platforms={(r.platforms||[]).join(' ')} data-status={r.status?.value||''} data-review={r.review_level||''} data-demo={r.demo?'true':'false'}><article class="card"><div class="meta"><span class="tag accent">{r.resource_type}</span><span class="tag">{r.review_level}</span>{r.status?.value&&<span class="tag">{r.status.value}</span>}{r.demo&&<span class="tag demo">DEMO</span>}</div><h3>{r.name}</h3><p>{text(r.summary)}</p><div class="meta">{(r.domains||[]).slice(0,4).map((x:string)=><span class="tag">{x}</span>)}</div><div class="card-footer"><span>{(r.platforms||[]).slice(0,3).join(' · ')||'platform n/a'}</span><span>View details →</span></div></article></a>)}</div>
<div id="tableView" class="table-wrap panel" hidden><table class="directory-table"><thead><tr><th>Name</th><th>Type</th><th>Domains</th><th>Platforms</th><th>Status</th><th>Review</th><th></th></tr></thead><tbody>{resources.map((r:any)=><tr class="resource-item" data-search={`${r.name} ${text(r.summary)} ${(r.domains||[]).join(' ')} ${(r.technologies||[]).join(' ')}`.toLowerCase()} data-type={r.resource_type||''} data-domains={(r.domains||[]).join(' ')} data-platforms={(r.platforms||[]).join(' ')} data-status={r.status?.value||''} data-review={r.review_level||''} data-demo={r.demo?'true':'false'}><td><a class="table-name" href={withBase(`/resources/${r.id}/`)}>{r.name}</a>{r.demo&&<span class="tag demo compact">DEMO</span>}<small>{text(r.summary)}</small></td><td>{r.resource_type}</td><td>{(r.domains||[]).slice(0,3).join(', ')||'—'}</td><td>{(r.platforms||[]).slice(0,3).join(', ')||'—'}</td><td>{r.status?.value||'—'}</td><td>{r.review_level||'—'}</td><td><a href={withBase(`/resources/${r.id}/`)}>Open →</a></td></tr>)}</tbody></table></div><div id="empty" class="empty panel" hidden>No resources match these filters.</div>
<script is:inline>
const ids=['q','type','domain','platform','status','review','demoOnly']; const els=Object.fromEntries(ids.map(id=>[id,document.getElementById(id)])); const count=document.getElementById('resultCount'),empty=document.getElementById('empty'),card=document.getElementById('cardView'),table=document.getElementById('tableView'),buttons=[...document.querySelectorAll('[data-view]')];
function root(){return table.hidden?card:table} function match(el){const qs=els.q.value.trim().toLowerCase();return (!qs||el.dataset.search.includes(qs))&&(!els.type.value||el.dataset.type===els.type.value)&&(!els.domain.value||el.dataset.domains.split(' ').includes(els.domain.value))&&(!els.platform.value||el.dataset.platforms.split(' ').includes(els.platform.value))&&(!els.status.value||el.dataset.status===els.status.value)&&(!els.review.value||el.dataset.review===els.review.value)&&(!els.demoOnly.checked||el.dataset.demo==='true')} function apply(){document.querySelectorAll('.resource-item').forEach(el=>el.hidden=!match(el));const n=[...root().querySelectorAll('.resource-item')].filter(el=>!el.hidden).length;count.textContent=`${n} resource${n===1?'':'s'}`;empty.hidden=n!==0}
ids.forEach(id=>els[id].addEventListener(id==='demoOnly'?'change':'input',apply)); document.getElementById('reset').onclick=()=>{ids.forEach(id=>els[id].type==='checkbox'?els[id].checked=false:els[id].value='');apply()}; function setView(v){card.hidden=v!=='cards';table.hidden=v!=='table';buttons.forEach(b=>b.classList.toggle('active',b.dataset.view===v));localStorage.setItem('resourceView',v);apply()} buttons.forEach(b=>b.onclick=()=>setView(b.dataset.view));setView(localStorage.getItem('resourceView')||'cards');
</script></Base>
