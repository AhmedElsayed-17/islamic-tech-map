---
import '../styles/global.css';
import { withBase } from '../lib/paths';
const { title='Islamic Tech Guide', description='Open directory for Islamic technology resources and ecosystem gaps.' }=Astro.props;
---
<!doctype html><html lang="en" dir="ltr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title></head>
<body><header class="site-header"><div class="shell nav"><a class="brand" href={withBase('/')}>Islamic Tech Guide <span class="version">v0.1</span></a><nav class="nav-links"><a href={withBase('/resources/')}>Resources</a><a href={withBase('/gaps/')}>Gaps</a><a href={withBase('/methodology/')}>Methodology</a><a href={withBase('/sources/')}>Sources</a><a href={withBase('/about/')}>About</a></nav></div></header>
<main class="shell"><slot /></main><footer class="footer"><div class="shell">Open-source ecosystem guide · one content model, multiple views. <span class="arabic-inline" dir="rtl">دليل مفتوح للمشاريع والأدوات والخدمات التقنية.</span></div></footer></body></html>
